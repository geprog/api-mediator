# Local development configuration for the API Mediator.
# Copy to `.env` (git-ignored) and adjust as needed:  cp .env.example .env
# docker-compose.yml and the mediator app both read these values.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# POSTGRES_* are consumed by docker-compose.yml to provision the container.
POSTGRES_USER=mediator
POSTGRES_PASSWORD=mediator
POSTGRES_DB=api_mediator
POSTGRES_PORT=5432

# What the mediator app connects with. Keep host/port/credentials in sync with
# the POSTGRES_* values above (host is localhost because the app runs on the
# host and reaches the container through the published port).
DATABASE_URL=postgres://mediator:mediator@localhost:5432/api_mediator

# ── Operator API ──────────────────────────────────────────────────────────
# HTTP port the mediator's operator API/UI (apps/backend) listens on. Bound to
# 127.0.0.1 in dev. Default 3333 is kept clear of Grafana's 3000 (GRAFANA_PORT)
# so the two never clash on the host.
HTTP_PORT=3333

# ── Adapter Server Runtime (Phase 5) ──────────────────────────────────────
# HTTP port the mediator's SECOND listener — the Adapter Server Runtime, which
# hosts each CONSUMER spec's operation surface as a virtual provider — listens
# on. Separate from HTTP_PORT so consumer traffic never reaches operator routes
# (docs/architecture/security.md). Default 3334; the scenarios override it to
# their reserved `1<scenario>900` host port.
ADAPTER_HTTP_PORT=3334

# ── App registration ──────────────────────────────────────────────────────
# Conservative default poll interval (milliseconds) stamped onto a
# RegisteredApp's capabilities when a registration omits `capabilities`
# entirely (all capability flags default false; the poll interval defaults
# here). Not consumed until the Phase-4 Sync Engine Scheduler. Default 300000
# ms (300 s).
MEDIATOR_DEFAULT_POLL_INTERVAL_MS=300000

# ── Sync Engine ───────────────────────────────────────────────────────────
# TEST/DEV-ONLY: gate the deterministic poll-trigger endpoint
# (POST /api/sync-rules/:id/poll), the SP-5 hook the SU-6 capstone e2e drives to
# force one poll cycle synchronously instead of waiting on the Scheduler's
# wall-clock interval. It is NOT an operator feature: with this off (the default)
# the route is not registered at all and a request 404s. Leave it false in
# production AND dev — only the e2e's backend environment sets it true.
SYNC_TEST_POLL_TRIGGER=false

# ── Credential Store ──────────────────────────────────────────────────────
# Master key (KEK) for envelope-encrypting per-app credentials (see
# docs/architecture/security.md and packages/credentials). A 32-byte key,
# base64-encoded (validated to exactly 32 decoded bytes — startup fails fast
# otherwise). The value below is a DEV-ONLY sample: PRODUCTION MUST set its own
# secret and keep it out of source control. Generate one with:
#   openssl rand -base64 32
# Rotating this key makes every credential stored under the old key
# unrecoverable, so treat it as long-lived, high-value secret material.
CREDENTIAL_MASTER_KEY=nuaKgT2sF/l6wkVY8+Qb8bMGHE0T+wee0CxRJCAzNCE=

# ── Operator authentication (Phase 3) ─────────────────────────────────────
# Local operator/viewer accounts — the Phase-3 auth provider's seed. There is
# deliberately NO unauthenticated mode (docs/architecture/security.md): every
# operator-API request must carry a valid identity, and mutations require the
# `operator` role while `viewer` is read-only.
#
# Format: comma-separated `username:role:passwordHash`, role = operator|viewer.
# passwordHash is a salted scrypt hash — NEVER a plaintext password (so no
# plaintext lives at rest, even here). Generate one with:
#   pnpm hash:operator-password '<password>'
# and paste the printed hash. The DEV-ONLY samples below are `operator` /
# `viewer` accounts with passwords `operator-dev-password` / `viewer-dev-password`;
# PRODUCTION MUST set its own accounts and keep them out of source control.
OPERATOR_ACCOUNTS=operator:operator:scrypt$16384$8$1$64$w2bnVOl/1VWnBYFUjy/K7A==$lLv52mSP/+MG2mV3vG5ES77GmXaUt9di9UO7ll5GOEGMI8goQvbZpATut+xQH/ejoFD7ON6HKI/HcZXO+YIJMA==,viewer:viewer:scrypt$16384$8$1$64$rxlWdhOmYgMWJOo400l5UA==$8RnU5a8lW/XwF3qXcn7oNYHuxdxzhEWXjmVGbuweFupc4jHIHdocfl4uj0YnxpX/+qccycTHZ2HTewwHqZjvIA==

# ── OpenTelemetry / Grafana ───────────────────────────────────────────────
# Every mediator component is instrumented with OpenTelemetry (see
# docs/architecture/observability.md). In dev, telemetry is exported via OTLP
# to the `grafana` container (the all-in-one Grafana LGTM stack in
# docker-compose.yml), which receives it and visualizes it in Grafana.
#
# HTTP/protobuf on 4318 avoids pulling in native gRPC deps; point the endpoint
# at the container's published OTLP port (localhost because the app runs on the
# host). Set to an empty value to disable exporting — the mediator functions
# correctly with the telemetry pipeline down.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Identifies the mediator's telemetry in Grafana (service.name).
OTEL_SERVICE_NAME=api-mediator

# Host port for the Grafana UI (http://localhost:${GRAFANA_PORT}). Configurable
# to avoid clashing with the mediator's own dev server.
GRAFANA_PORT=3000

# ── Mapping Engine LLM provider ───────────────────────────────────────────
# The Mapping Engine is provider-agnostic (LLMMappingProvider, see
# docs/architecture/mapping-engine.md). For local development it is backed by a
# self-hosted open-weight model served by Ollama running on the host.
# Every MappingProposal records `generatedBy: { providerId, model, promptVersion }`,
# so MAPPING_LLM_PROVIDER / MAPPING_LLM_MODEL below are what gets stamped on
# each proposal for reproducibility.
MAPPING_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# gemma4:26b (default): a 26B instruct model that produces valid, recall-biased
# shortlists where glm-4.7-flash is too weak — under Ollama's schema-constrained
# decoding glm returns terse/near-empty or malformed JSON, hurting recall.
# Accuracy/speed tradeoff: gemma4:26b is more accurate but SLOWER on CPU (a full
# detail call can take a minute-plus); glm-4.7-flash:latest remains selectable
# for fast, lower-accuracy iteration. Overridable — point this at any pulled
# instruct/chat model; see DEVELOPMENT.md for the rationale and how to switch.
# The value is recorded on each MappingProposal.generatedBy for reproducibility.
MAPPING_LLM_MODEL=gemma4:26b

# Deterministic decoding for reproducible, schema-faithful proposals.
MAPPING_LLM_TEMPERATURE=0

# Let the reasoning model emit its private thinking channel before the JSON
# answer. NOTE: empirically, combining `think: true` with Ollama's
# schema-constrained decoding (`format`) on glm-4.7-flash makes a mapping call
# hang past the request timeout (the grammar constraint fights the thinking
# pass) — detection calls then fail/time out. Keep this OFF for the mapping
# engine; with thinking off a shortlist call returns valid JSON in ~25s.
MAPPING_LLM_THINKING=false

# CPU inference is slow (~15-20 tok/s here); a full detail call with schemas
# can take one to a few minutes. Timeout is generous so real calls don't abort.
MAPPING_LLM_REQUEST_TIMEOUT_MS=300000

# Corrective-retry ceiling per LLM call when the output fails schema validation
# (matches the cap described in docs/architecture/mapping-engine.md).
MAPPING_LLM_MAX_RETRIES=3

# Confidence threshold (0..1) below which a proposal item is flagged
# `reviewRequired` in the Phase-3 review UI. Derived, never stored — changing it
# re-flags every item without re-analysis (TD-5).
MAPPING_LLM_REVIEW_THRESHOLD=0.7

# ── Anthropic (Claude) provider ───────────────────────────────────────────
# The Mapping Engine is provider-agnostic; besides Ollama it can be backed by
# the Claude Messages API. Structured output uses forced tool use (the Anthropic
# equivalent of Ollama's schema-constrained `format`), reusing the same shared
# schemas/prompts/validators, so detection behaves identically across providers.
#
# To run detection (or the eval harness) against Claude Sonnet 5, set:
#   MAPPING_LLM_PROVIDER=anthropic
#   MAPPING_LLM_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...
# MAPPING_LLM_TEMPERATURE / MAPPING_LLM_THINKING are Ollama-specific and ignored
# by the Anthropic provider (a non-default temperature is rejected by Claude's
# request surface, and extended thinking is incompatible with forced tool use).
# Required only when MAPPING_LLM_PROVIDER=anthropic; leave unset for Ollama.
ANTHROPIC_API_KEY=
