{
  "name": "api-mediator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm build",
    "test:e2e": "pnpm --filter @mediator/e2e run test:e2e",
    "db:generate": "pnpm --filter @mediator/db db:generate",
    "db:migrate": "pnpm --filter @mediator/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.6.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1"
  }
}
