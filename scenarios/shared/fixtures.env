# Shared identity fixtures used by every scenario's bootstrap/seed scripts.
#
# These values ARE the identity keys the mediator's sync engine must correlate
# on (docs/architecture/sync-engine.md): usernames/emails for users, titles for
# work items, names for labels/customers/projects. Keep them identical across
# apps — that overlap is the point.

ADMIN_USER=mediator-admin
ADMIN_PASS=mediator-pass-123
# For apps whose password policy demands upper+lower+digit (e.g. OrangeHRM).
ADMIN_PASS_STRICT=Mediator-Pass-123
ADMIN_EMAIL=admin@example.test

ALICE_USER=alice
ALICE_EMAIL=alice@example.test
ALICE_PASS=alice-pass-123
ALICE_FIRST=Alice
ALICE_LAST=Anderson

BOB_USER=bob
BOB_EMAIL=bob@example.test
BOB_PASS=bob-pass-1234
BOB_FIRST=Bob
BOB_LAST=Baker

# The shared container: Gitea/Forgejo repo, Vikunja project, Wekan board.
PROJECT_NAME=phoenix

# Overlapping work items (identity = title), created in every work-item app.
WORK_ITEM_1_TITLE="Fix login button alignment"
WORK_ITEM_1_DESC="The login button drifts off-grid on viewports below 400px."
WORK_ITEM_1_LABEL=bug
WORK_ITEM_1_DUE="2026-08-03T12:00:00Z"
WORK_ITEM_2_TITLE="Update onboarding docs"
WORK_ITEM_2_DESC="The onboarding guide still references the old SSO flow."
WORK_ITEM_2_LABEL=docs
WORK_ITEM_3_TITLE="Prepare Q3 release"
WORK_ITEM_3_DESC="Collect release notes and tag the release."
# WORK_ITEM_3 is closed/done wherever it is created -> state<->done coercion case.

# Labels (identity = name/title). Colors deliberately hex-without-hash where the
# target API wants it that way — a small, real coercion case.
LABEL_BUG_NAME=bug
LABEL_BUG_COLOR=ee0701
LABEL_DOCS_NAME=docs
LABEL_DOCS_COLOR=0075ca

# Per-app non-overlap records (created in exactly one app) keep detection honest.
UNIQUE_GITEA_TITLE="Refactor CI pipeline"
UNIQUE_FORGEJO_TITLE="Rotate deploy keys"
UNIQUE_VIKUNJA_TITLE="Water the office plants"
UNIQUE_WEKAN_TITLE="Design new landing page"

# Scenario 5 (business suite) fixtures.
CUSTOMER_NAME="ACME Corp"
S5_PROJECT_NAME="Phoenix Rollout"
TIME_ENTRY_DAY="2026-07-06"
TIME_ENTRY_BEGIN="2026-07-06T09:00:00Z"
TIME_ENTRY_END="2026-07-06T11:30:00Z"
KIMAI_ACTIVITY_NAME="Code Review"
